{
  "$schema": "../../schema/source.schema.json",
  "contractVersion": 1,
  "key": "gutenberg",
  "name": "Project Gutenberg",
  "version": "1.3.0",
  "description": "Classic books from the Project Gutenberg catalog at gutenberg.org, read through its official OPDS catalog (public domain in the United States).",
  "kinds": ["book"],
  "langs": ["en", "fr", "de", "es", "it", "pt", "nl"],
  "rights": {
    "basis": "public-domain",
    "notes": "Public domain in the United States; check local copyright terms elsewhere. A few books in the catalog are still under copyright in the US: their Project Gutenberg page says so. Free distribution keeps the Project Gutenberg licence notice inside each file; charging for access requires a 20% royalty to the Project Gutenberg Literary Archive Foundation, unless every Project Gutenberg reference is removed. Read through gutenberg.org's official OPDS catalog, by each reader's device, at a low rate; no bulk downloading."
  },
  "hosts": ["www.gutenberg.org"],
  "rateLimit": {"requestsPerMinute": 30},
  "ratings": {"default": "safe", "map": {"erotic": "erotica"}},
  "categories": [
    {"id": "s.Fiction", "name": "Fiction"},
    {"id": "s.Poetry", "name": "Poetry"},
    {"id": "s.Drama", "name": "Drama"},
    {"id": "s.Science fiction", "name": "Science fiction"},
    {"id": "s.Adventure", "name": "Adventure"},
    {"id": "s.Love stories", "name": "Romance"},
    {"id": "s.Detective", "name": "Mystery"},
    {"id": "s.Horror", "name": "Horror"},
    {"id": "s.Fairy tales", "name": "Fairy tales"},
    {"id": "s.Juvenile", "name": "Children"},
    {"id": "s.History", "name": "History"},
    {"id": "s.Philosophy", "name": "Philosophy"}
  ],
  "catalog": {
    "request": {
      "url": "https://www.gutenberg.org/ebooks/search.opds/",
      "type": "xml",
      "query": {
        "query": "{{search}} {{category}}",
        "sort_order": "downloads"
      },
      "pagination": {"type": "startIndex", "param": "start_index", "pageSize": 25, "base": 1}
    },
    "list": {"css": "entry"},
    "item": {
      "id": {"css": "id", "then": [{"regex": "/ebooks/([0-9]+)\\.opds"}]},
      "name": {"css": "title", "then": ["trim", "collapseSpaces"]},
      "cover": {"css": "id", "then": [{"regex": "/ebooks/([0-9]+)\\.opds"}, {"format": "https://www.gutenberg.org/cache/epub/{value}/pg{value}.cover.medium.jpg"}]},
      "kind": {"const": "book"},
      "format": {"const": "text"},
      "status": {"const": "completed"}
    },
    "hasNext": {"css": "link[rel=next]", "attr": "href", "then": ["notNull"]}
  },
  "title": {
    "request": {"url": "https://www.gutenberg.org/ebooks/{{id}}.opds", "type": "xml"},
    "fields": {
      "name": {"css": "entry title", "then": ["trim", "collapseSpaces"]},
      "description": {"css": "entry content p:matches(^Summary:)", "then": [{"regex": "^Summary:\\s*"}, "collapseSpaces"], "default": ""},
      "cover": {"template": "https://www.gutenberg.org/cache/epub/{{id}}/pg{{id}}.cover.medium.jpg"},
      "authors": {"css": "entry author name"},
      "genres": {"css": "entry category[scheme='http://purl.org/dc/terms/LCSH']", "attr": "term", "all": true},
      "contentRating": {"css": "entry category[scheme='http://purl.org/dc/terms/LCSH'][term*='Erotic']", "attr": "term", "then": [{"regex": "(Erotic)"}, "lower"]},
      "status": {"const": "completed"},
      "format": {"const": "text"}
    },
    "units": {"single": {"id": "{{id}}", "name": "Full text"}}
  },
  "content": {
    "book": {
      "document": {
        "url": {"template": "https://www.gutenberg.org/cache/epub/{{id}}/pg{{id}}-images.epub"},
        "mediaType": "application/epub+zip"
      }
    }
  }
}
