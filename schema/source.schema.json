{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vovoscan.app/schemas/source/1.json",
  "title": "vovoscan source manifest",
  "description": "Une source de contenu décrite par des règles déclaratives : aucune exécution de code, seulement des requêtes vers les hôtes déclarés et des extractions (JSONPath, CSS) suivies de transformations connues. Contrat version 1. Copie de référence : vovoscan-be, src/vovoscan/features/catalog/domain/contract/source.schema.json.",
  "type": "object",
  "required": [
    "contractVersion",
    "key",
    "name",
    "version",
    "kinds",
    "langs",
    "rights",
    "catalog",
    "title",
    "content"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "contractVersion": {
      "const": 1
    },
    "key": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,62}$",
      "description": "Identifiant stable, en kebab-case. « vovoscan » est réservé à la source interne."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "kinds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "comic",
          "book",
          "audiobook",
          "video"
        ]
      }
    },
    "langs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z]{2}$"
      }
    },
    "rights": {
      "type": "object",
      "required": [
        "basis",
        "notes"
      ],
      "additionalProperties": false,
      "properties": {
        "basis": {
          "enum": [
            "public-domain",
            "licensed"
          ],
          "description": "Base de droits revendiquée ; l'admin la confirme à l'activation (preuve exigée pour licensed)."
        },
        "notes": {
          "type": "string",
          "minLength": 10,
          "description": "Conditions de la source : licence, obligations, limites géographiques."
        }
      }
    },
    "settings": {
      "type": "object",
      "description": "Réglages fixés par un admin à l'installation (adresse d'une instance, d'un miroir…). Utilisables dans les modèles : {{settings.nom}}.",
      "additionalProperties": {
        "$ref": "#/$defs/setting"
      }
    },
    "hosts": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Hôtes fixes autorisés en plus de ceux des réglages de type url."
    },
    "rateLimit": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requestsPerMinute": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600
        }
      }
    },
    "catalog": {
      "$ref": "#/$defs/listSection"
    },
    "title": {
      "type": "object",
      "required": [
        "request",
        "fields",
        "units"
      ],
      "additionalProperties": false,
      "properties": {
        "request": {
          "$ref": "#/$defs/request"
        },
        "fields": {
          "type": "object",
          "required": [
            "name"
          ],
          "additionalProperties": false,
          "properties": {
            "name": {
              "$ref": "#/$defs/value"
            },
            "description": {
              "$ref": "#/$defs/value"
            },
            "cover": {
              "$ref": "#/$defs/value"
            },
            "authors": {
              "$ref": "#/$defs/value"
            },
            "genres": {
              "$ref": "#/$defs/value"
            },
            "status": {
              "$ref": "#/$defs/value"
            },
            "format": {
              "$ref": "#/$defs/value"
            }
          }
        },
        "units": {
          "oneOf": [
            {
              "type": "object",
              "required": [
                "list",
                "item"
              ],
              "additionalProperties": false,
              "properties": {
                "list": {
                  "$ref": "#/$defs/selector"
                },
                "item": {
                  "type": "object",
                  "required": [
                    "id"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "id": {
                      "$ref": "#/$defs/value"
                    },
                    "number": {
                      "$ref": "#/$defs/value"
                    },
                    "name": {
                      "$ref": "#/$defs/value"
                    }
                  }
                }
              }
            },
            {
              "type": "object",
              "required": [
                "single"
              ],
              "additionalProperties": false,
              "properties": {
                "single": {
                  "type": "object",
                  "required": [
                    "id"
                  ],
                  "additionalProperties": false,
                  "description": "Le titre est lu d'un seul tenant (livre en un fichier).",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          ]
        }
      }
    },
    "content": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "comic": {
          "type": "object",
          "required": [
            "request",
            "list",
            "item"
          ],
          "additionalProperties": false,
          "properties": {
            "request": {
              "$ref": "#/$defs/request"
            },
            "list": {
              "$ref": "#/$defs/selector"
            },
            "item": {
              "type": "object",
              "required": [
                "url"
              ],
              "additionalProperties": false,
              "properties": {
                "url": {
                  "$ref": "#/$defs/value"
                },
                "width": {
                  "$ref": "#/$defs/value"
                },
                "height": {
                  "$ref": "#/$defs/value"
                }
              }
            }
          }
        },
        "book": {
          "type": "object",
          "required": [
            "document"
          ],
          "additionalProperties": false,
          "properties": {
            "request": {
              "$ref": "#/$defs/request"
            },
            "document": {
              "type": "object",
              "required": [
                "url",
                "mediaType"
              ],
              "additionalProperties": false,
              "properties": {
                "url": {
                  "$ref": "#/$defs/value"
                },
                "mediaType": {
                  "const": "application/epub+zip",
                  "description": "EPUB seulement pour l'instant : un fichier fermé, que le lecteur affiche sans exécuter de script."
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "setting": {
      "type": "object",
      "required": [
        "label",
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "label": {
          "type": "string"
        },
        "type": {
          "enum": [
            "url",
            "string",
            "integer"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "default": {
          "type": [
            "string",
            "integer"
          ]
        },
        "help": {
          "type": "string"
        }
      }
    },
    "request": {
      "type": "object",
      "required": [
        "url",
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "url": {
          "type": "string",
          "description": "Modèle d'URL : {{settings.x}}, {{page}}, {{search}}, {{lang}}, {{id}}, {{unitId}}."
        },
        "query": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "Paramètres ; une valeur vide n'est pas envoyée."
        },
        "type": {
          "enum": [
            "json",
            "html"
          ]
        }
      }
    },
    "selector": {
      "description": "Liste de nœuds : un JSONPath (« $.results[*] ») ou un sélecteur CSS ({\"css\": \"div.card\"}).",
      "oneOf": [
        {
          "type": "string",
          "pattern": "^\\$"
        },
        {
          "type": "object",
          "required": [
            "css"
          ],
          "additionalProperties": false,
          "properties": {
            "css": {
              "type": "string"
            }
          }
        }
      ]
    },
    "transform": {
      "oneOf": [
        {
          "enum": [
            "trim",
            "string",
            "number",
            "integer",
            "lower",
            "absUrl",
            "first",
            "notNull",
            "collapseSpaces"
          ]
        },
        {
          "type": "object",
          "required": [
            "regex"
          ],
          "additionalProperties": false,
          "properties": {
            "regex": {
              "type": "string"
            },
            "group": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        {
          "type": "object",
          "required": [
            "replace"
          ],
          "additionalProperties": false,
          "properties": {
            "replace": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "string"
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "join"
          ],
          "additionalProperties": false,
          "properties": {
            "join": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "map"
          ],
          "additionalProperties": false,
          "properties": {
            "map": {
              "type": "object"
            },
            "default": {}
          }
        },
        {
          "type": "object",
          "required": [
            "pluck"
          ],
          "additionalProperties": false,
          "properties": {
            "pluck": {
              "type": "string",
              "pattern": "^\\$"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "format"
          ],
          "additionalProperties": false,
          "properties": {
            "format": {
              "type": "string",
              "description": "Modèle où {value} est la valeur courante ; {{settings.x}} et les variables y sont aussi remplacées."
            }
          }
        }
      ]
    },
    "value": {
      "description": "Une valeur : un JSONPath, ou un objet path / css / const / template, suivi de transformations.",
      "oneOf": [
        {
          "type": "string",
          "pattern": "^\\$"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^\\$"
            },
            "css": {
              "type": "string"
            },
            "attr": {
              "type": "string",
              "description": "text (défaut), html, ou le nom d'un attribut"
            },
            "all": {
              "type": "boolean",
              "description": "Toutes les correspondances (liste) plutôt que la première."
            },
            "const": {},
            "template": {
              "type": "string"
            },
            "then": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/transform"
              }
            },
            "default": {}
          }
        }
      ]
    },
    "listSection": {
      "type": "object",
      "required": [
        "request",
        "list",
        "item"
      ],
      "additionalProperties": false,
      "properties": {
        "request": {
          "$ref": "#/$defs/request"
        },
        "list": {
          "$ref": "#/$defs/selector"
        },
        "item": {
          "type": "object",
          "required": [
            "id",
            "name"
          ],
          "additionalProperties": false,
          "properties": {
            "id": {
              "$ref": "#/$defs/value"
            },
            "name": {
              "$ref": "#/$defs/value"
            },
            "cover": {
              "$ref": "#/$defs/value"
            },
            "kind": {
              "$ref": "#/$defs/value"
            },
            "format": {
              "$ref": "#/$defs/value"
            },
            "status": {
              "$ref": "#/$defs/value"
            }
          }
        },
        "hasNext": {
          "$ref": "#/$defs/value"
        },
        "total": {
          "$ref": "#/$defs/value"
        }
      }
    }
  }
}
